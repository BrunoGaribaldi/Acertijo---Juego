# ─────────────────────────────────────────────────────
# Neon PostgreSQL — get these from https://console.neon.tech
# ─────────────────────────────────────────────────────

# Pooled connection (used at runtime — hostname contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Direct connection (used only by Prisma CLI: db push, studio)
DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ─────────────────────────────────────────────────────
# Admin credentials — change these before deploying
# ─────────────────────────────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me_in_production"

# ─────────────────────────────────────────────────────
# Session encryption key — generate with: openssl rand -hex 32
# Must be at least 32 characters long
# ─────────────────────────────────────────────────────
SESSION_SECRET="replace_this_with_a_random_32_plus_character_string"
